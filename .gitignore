# =========================================================================
# Trullo dei Messapi - Git Ignore Rules
# =========================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/

# Sensitive documents & private spreadsheets (Prezzi, Tariffe interne)
*.xlsx
*.xls
*.csv
*.ods
Tariffe_2026.xlsx
Tariffe_*.xlsx

# Raw unoptimized photo working folders (Website uses optimized public/images/)
FOTO PER SITI/
foto per siti/
RAW_PHOTOS/
raw_photos/

# Environment variables, credentials & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
~$*
